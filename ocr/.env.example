# OCR Function App Configuration

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Azure Production:
# FRONTEND_URL=https://your-app.azurestaticapps.net

# Port for local development
PORT=8000

# PaddleOCR Configuration
# Default language (can be overridden per request)
DEFAULT_OCR_LANGUAGE=en

# Supported languages:
# en - English
# ch - Chinese
# ta - Tamil
# te - Telugu
# ka - Kannada
# hi - Hindi
# mr - Marathi
# ne - Nepali
# ur - Urdu
# ar - Arabic
# fr - French
# de - German
# es - Spanish
# pt - Portuguese
# ru - Russian
# ja - Japanese
# ko - Korean

# LaTeX OCR API Integration Configuration

# Groq API Key (required for final answer generation)
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Wolfram Alpha App ID (optional but recommended)
# Get your App ID from: https://products.wolframalpha.com/api
WOLFRAM_APP_ID=your_wolfram_app_id_here
