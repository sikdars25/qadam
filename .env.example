# LaTeX OCR API Integration Environment Variables
# Copy this file to .env and fill in your actual API keys

# Groq API Key (required for final answer generation)
# Get your API key from: https://console.groq.com
# 1. Visit https://console.groq.com
# 2. Sign up or log in
# 3. Go to API Keys section
# 4. Create a new API key
# 5. Copy the key to your .env file
GROQ_API_KEY=your_groq_api_key_here

# Wolfram Alpha App ID (optional but recommended)
# Get your App ID from: https://products.wolframalpha.com/api
# 1. Visit https://products.wolframalpha.com/api
# 2. Sign up for a free account
# 3. Create a new app
# 4. Copy the App ID to your .env file
WOLFRAM_APP_ID=your_wolfram_app_id_here
